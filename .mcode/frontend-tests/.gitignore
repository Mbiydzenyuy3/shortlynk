# Playwright's per-run outputs — uploaded to GCS by morph, never committed.
/test-results/
/playwright-results.json
/playwright-report/
/blob-report/
/.last-run.json

# Local test-runner dependencies.
/node_modules/

# Auth storage state
/storage-state.json

# Test credentials (regenerated at runtime by global.setup.ts)
/.test-credentials.json
